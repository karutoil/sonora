# sonora — environment
#
# Copy this file to `.env` and fill in the values:
#
#   cp .env.example .env
#
# REQUIRED .... SONORA_SECRET (in a container) and SONORA_PASSPHRASE (first run only)
# OPTIONAL .... everything else — each one has a working default
#
# Generate the secret with:  openssl rand -hex 32
#
# Tags used below:
#   [required]     no safe default; a container refuses to start without it
#   [first-run]    only while the users table is empty
#   [conditional]  needed only for a specific setup (proxy, tunnel, a feature)
#   [optional]     has a working default
#
# `podman compose` and `docker compose` read `.env` automatically. A blank value
# is treated as "unset" for most keys, but NOT for SONORA_SECRET: the container
# entrypoint refuses to start with an empty secret.

# ─── Core ────────────────────────────────────────────────────────────────────

# [required] Signs session cookies AND derives the AES key that encrypts an
# imported YouTube cookie jar. Mandatory in a container. Random per process in
# dev, so a forgotten value can never ship a fixed key — but it also means every
# restart signs everyone out and loses the jar key. Generate once, keep stable.
SONORA_SECRET=

# [first-run] The first account, created only while the users table is empty.
# It is an admin by construction. Once any user exists these two are ignored.
# SONORA_USER defaults to a historical name; set it explicitly for a new instance.
SONORA_USER=admin
SONORA_PASSPHRASE=

# [optional] Bind address for the published port (compose only). Loopback
# matches dev and expects a TLS proxy or tunnel in front. Use 0.0.0.0 to reach
# it from a phone on the LAN. Never publish this to the open internet without
# TLS and a login.
SONORA_BIND=127.0.0.1

# [optional] Fastify log level: fatal | error | warn | info | debug | trace.
SONORA_LOG_LEVEL=info

# [optional] HTTP port and bind address. Compose sets both for the container
# (PORT=8130, HOST=0.0.0.0), so these are mainly useful when running the
# server directly without a .env-aware launcher.
# PORT=8130
# HOST=127.0.0.1

# ─── Storage ────────────────────────────────────────────────────────────────

# [optional] SQLite database and the audio cache. Defaults are relative to the
# repo and are correct for both `npm start` and the compose bind mount.
# SONORA_DB=./data/sonora.db
# SONORA_AUDIO_DIR=./data/audio

# [optional] Audio cache ceiling, in MB. Least-recently-used tracks evict first.
SONORA_CACHE_MB=8192

# [optional] How many yt-dlp downloads may run at once, and the safety ceiling
# for one download.
SONORA_MAX_DOWNLOADS=4
SONORA_DOWNLOAD_TIMEOUT_MS=120000

# ─── Sessions & sign-in ─────────────────────────────────────────────────────

# [optional] How long an access token lasts. A remembered device renews it
# silently with its rotating refresh token, so this can stay short.
SONORA_SESSION_MINUTES=720

# [optional] How long a "remember this device" refresh token stays valid.
# Revocable from Account → Security, and destroyed by "sign out everywhere".
SONORA_REFRESH_DAYS=30

# [optional] Legacy alias for SONORA_REFRESH_DAYS, kept so an existing deployment
# keeps working. New setups should set SONORA_REFRESH_DAYS instead.
# SONORA_SESSION_DAYS=90

# [optional] Sign-in attempts per window, per client. Ten a minute is generous
# for one person and hostile to a script; raise it for a household on one IP.
SONORA_LOGIN_RATE_MAX=10
SONORA_LOGIN_RATE_WINDOW="1 minute"

# [optional] Trust X-Forwarded-* from a TLS proxy or tunnel, so rate limiting
# sees real client IPs instead of the proxy's. Set 0 only if nothing is in front.
SONORA_TRUST_PROXY=1

# ─── Passkeys & public URLs ─────────────────────────────────────────────────
#
# A passkey is bound to a registrable domain, NOT an IP. Unset, the RP ID and
# origin come from the request's Host header, which is correct for localhost
# (http://localhost:8130) and a direct HTTPS proxy.

# [conditional] Set both when a tunnel rewrites Host, or when the public origin
# differs from what the process sees:
#   SONORA_RP_ID=music.example.com
#   SONORA_ORIGIN=https://music.example.com
SONORA_RP_ID=
SONORA_ORIGIN=

# [optional] Name shown by the passkey prompt.
SONORA_RP_NAME=sonora

# [conditional] Absolute origin used in shared-track cards (og:url, og:image,
# oEmbed), e.g. https://music.example.com. Empty falls back to the request's
# Host header, which is right for localhost or a LAN and wrong behind a proxy
# that rewrites Host.
SONORA_PUBLIC_URL=

# ─── Listen Together rooms ──────────────────────────────────────────────────
#
# A room is one shared playhead: several people follow the same track at the
# same position.

# [optional] A room is deleted after this many hours with no command, no join
# and nobody connected, or an hour after the host ends it.
SONORA_ROOM_HOURS=12

# [optional] The member cap is what keeps a room a room instead of a broadcast.
SONORA_ROOM_MAX_MEMBERS=50

# ─── YouTube fetching ───────────────────────────────────────────────────────
#
# None of these is required. The defaults work on a clean host. They exist
# because YouTube intermittently gates whole IPs behind "sign in to confirm
# you're not a bot". The admin panel reports their state.

# [optional] Path to the yt-dlp binary. Autodetected from
# ~/.local/share/sonora-venv, then from PATH. The container image installs it at
# /usr/local/bin/yt-dlp.
# SONORA_YTDLP=/usr/local/bin/yt-dlp

# [optional] Proxy for yt-dlp: http://127.0.0.1:8118, socks5://127.0.0.1:1080, …
# The only mitigation that actually changes the source IP.
# SONORA_YTDLP_PROXY=

# [optional] A cookies.txt file for yt-dlp. The in-app import (Admin → YouTube)
# is usually easier, and stores an encrypted copy under ./data instead.
# SONORA_YTDLP_COOKIES=

# [optional] Raw Cookie: header used by youtubei.js for metadata requests.
# SONORA_YT_COOKIE=

# [optional] bgutil PO-token provider. Empty string disables it. In compose this
# is set automatically to the host provider at host.containers.internal:4416.
# SONORA_POT_PROVIDER=http://127.0.0.1:4416

# [optional] JS runtime yt-dlp uses to solve YouTube's JS challenges:
# deno:/path or node:/path. Empty disables it (extraction is weaker without
# one). Autodetects a Deno install under $HOME; the container uses its node.
# SONORA_JS_RUNTIME=

# [optional] Stream URL cache lifetime. YouTube embeds an expiry (~6 h); refresh
# early.
# SONORA_URL_TTL_MS=10800000

# [optional] Metadata / search request timeout.
# SONORA_RESOLVE_TIMEOUT_MS=25000

# ─── Container only (compose) ───────────────────────────────────────────────
#
# [optional] Resolvers passed to the container (`dns:` in compose.yaml).
# Rootless podman's own forwarder can take seconds per external name, which
# shows up as slow thumbnails and slow track fetches. The public defaults work
# anywhere. If your LAN gateway is faster, use it:
#   SONORA_DNS_1=192.168.1.1
#   SONORA_DNS_2=1.1.1.1
SONORA_DNS_1=1.1.1.1
SONORA_DNS_2=8.8.8.8

# ─── Tests only ─────────────────────────────────────────────────────────────

# [optional] Chromium binary for the browser-based tests. Autodetected from
# PATH; set this if Chromium lives somewhere unusual.
# CHROME_BIN=/usr/bin/chromium

# [optional] Reserved: parsed by src/config.js but not applied yet. Harmless to
# leave out.
# SONORA_UPSTREAM_TIMEOUT_MS=20000
