{
  "id": "/",
  "name": "sonora",
  "short_name": "sonora",
  "description": "Your own music, your own algorithm. A personal YouTube music player with radio, likes, playlists and an offline app shell.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#111215",
  "theme_color": "#111215",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music", "entertainment", "lifestyle"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "focus-existing" },
  "screenshots": [
    {
      "src": "/screenshots/narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Discover, with today's picks and recent listening"
    },
    {
      "src": "/screenshots/wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "The full library in a desktop window"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Discover",
      "short_name": "Discover",
      "description": "Today's picks and your recent listening",
      "url": "/?page=home",
      "icons": [{ "src": "/icons/shortcuts/wave.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Find a song, album or artist",
      "url": "/?page=search",
      "icons": [{ "src": "/icons/shortcuts/search.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Liked songs",
      "short_name": "Liked",
      "description": "Everything you have hearted",
      "url": "/?collection=liked",
      "icons": [{ "src": "/icons/shortcuts/heart.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Radio",
      "short_name": "Radio",
      "description": "Endless stations built from your library",
      "url": "/?page=radio",
      "icons": [{ "src": "/icons/shortcuts/radio.png", "sizes": "96x96", "type": "image/png" }]
    }
  ]
}
